# ───────── 引擎選擇 ─────────
# auto（預設）：有 HUNYUAN_URL 用自架 Hunyuan3D；否則有 MESHY_API_KEY 用 Meshy；否則 mock 示範模式
# 也可明確指定：hunyuan | meshy | mock
MODEL_PROVIDER=auto

# ───────── A. 自架 Hunyuan3D（免 credits，需要 NVIDIA GPU） ─────────
# 用 server/setup_hunyuan.sh 安裝、server/start.sh 啟動後：
HUNYUAN_URL=http://127.0.0.1:8081
# 1 = 形狀 + PBR 貼圖（約 29GB VRAM，慢）；0 = 只做形狀（約 10GB VRAM，快很多）
HUNYUAN_TEXTURE=1
HUNYUAN_OCTREE_RESOLUTION=256
HUNYUAN_STEPS=30
HUNYUAN_TIMEOUT_SEC=1800

# 文字建模需要「文字 → 參考圖」服務。可用 server/t2i_server.py（SDXL-Turbo），
# 或任何開了 --api 的 AUTOMATIC1111 / Forge。沒設定時只能用圖片建模。
T2I_URL=http://127.0.0.1:7860
T2I_STEPS=4
T2I_SIZE=768
T2I_CFG=1
T2I_TIMEOUT_SEC=120

# 產出的 GLB / 預覽圖存放位置
DATA_DIR=data

# ───────── B. Meshy API（按 credits 計費） ─────────
MESHY_API_KEY=
MESHY_SKIP_REFINE=0
